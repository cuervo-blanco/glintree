{
  "manifest_version": 3,
  "name": "TextReadsFast for YouTube",
  "version": "0.1.0",
  "description": "Read articles and YouTube captions with word focus, structured text, romanization and reading controls.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["reader.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "fonts/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TextReadsFast settings"
  },
  "background": {
    "service_worker": "background.js"
  }
}
