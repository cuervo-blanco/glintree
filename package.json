{
  "name": "textreadsfast-youtube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn languages and read faster with YouTube captions",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-drift": "node scripts/check-drift.mjs",
    "check": "pnpm run typecheck && pnpm test",
    "shoot": "node scripts/build.mjs --dev && python scripts/shoot.py",
    "reel": "node scripts/build.mjs --dev && python scripts/reel.py"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.2.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4"
  }
}
